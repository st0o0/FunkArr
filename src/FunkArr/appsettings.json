{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Akka": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information"
      }
    }
  },
  "FunkArr": {
    "ApiKey": "funkarr-default-api-key",
    "PersistencePath": "data/funkarr.db",
    "DataPath": "data",
    "ScoringPoolSize": 4,
    "MatchHistory": {
      "MaxSnapshots": 100,
      "MaxAgeDays": 30,
      "SnapshotInterval": 20
    }
  }
}
