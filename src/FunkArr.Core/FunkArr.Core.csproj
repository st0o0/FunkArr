<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="FunkArr.Download.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FunkArr.Messages\FunkArr.Messages.csproj" />
    <ProjectReference Include="..\FunkArr.Persistence\FunkArr.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka.Hosting" />
    <PackageReference Include="Akka.Cluster.Hosting" />
    <PackageReference Include="Akka.Cluster.Sharding" />
    <PackageReference Include="Akka.Logger.Serilog" />
    <PackageReference Include="Akka.Persistence.Sql.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Akka.Streams" />
<PackageReference Include="Terp" />
    <PackageReference Include="Terp.Akka" />
    <PackageReference Include="System.IO.Abstractions" />
  </ItemGroup>

  <Target Name="GenerateVersionConst" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_VersionString>$(InformationalVersion)</_VersionString>
      <_VersionString Condition="'$(_VersionString)' == ''">$(Version)</_VersionString>
      <_VersionString>$(_VersionString.Split('+')[0])</_VersionString>
      <_VersionSourceFile>$(IntermediateOutputPath)VersionInfo.g.cs</_VersionSourceFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_VersionSourceFile)" Overwrite="true"
                      Lines="namespace FunkArr.Core%3B%0A%0Apublic static class VersionInfo%0A{%0A    public const string Version = &quot;$(_VersionString)&quot;%3B%0A}" />
    <ItemGroup>
      <Compile Include="$(_VersionSourceFile)" />
    </ItemGroup>
  </Target>

</Project>
