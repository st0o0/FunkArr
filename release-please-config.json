{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "component": "funkarr",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": true,
      "separate-pull-requests": true,
      "pull-request-title-pattern": "chore${scope}: release FunkArr v${version}",
      "pull-request-header": ":package: FunkArr Release",
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "hidden": true },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "style", "hidden": true },
        { "type": "test", "hidden": true },
        { "type": "ci", "hidden": true },
        { "type": "build", "hidden": true },
        { "type": "deps", "section": "Dependencies" }
      ]
    },
    "data/community": {
      "release-type": "simple",
      "component": "rulesets",
      "bump-minor-pre-major": true,
      "include-component-in-tag": true,
      "separate-pull-requests": true,
      "pull-request-title-pattern": "chore${scope}: release Rulesets v${version}",
      "pull-request-header": ":package: Rulesets Release",
      "changelog-sections": [
        { "type": "feat", "section": "New Rulesets" },
        { "type": "fix", "section": "Ruleset Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "docs", "section": "Documentation" },
        { "type": "chore", "hidden": true },
        { "type": "refactor", "section": "Refactoring" },
        { "type": "style", "hidden": true },
        { "type": "test", "hidden": true },
        { "type": "ci", "hidden": true },
        { "type": "build", "hidden": true },
        { "type": "deps", "section": "Dependencies" }
      ]
    }
  }
}
