{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/st0o0/FunkArr/ruleset.schema.json",
  "title": "FunkArr Ruleset",
  "description": "Schema for FunkArr community and local ruleset files",
  "type": "object",
  "required": ["topic", "rules"],
  "additionalProperties": false,
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the show or media"
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Alternative names for topic matching"
    },
    "media": { "$ref": "#/$defs/mediaReference" },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Default confidence score for rules without their own"
    },
    "rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" },
      "description": "Ordered list of matching rules"
    },
    "standalone": {
      "type": "boolean",
      "default": false,
      "description": "Local only: if true, ignore community base and use this ruleset as-is"
    },
    "disable": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,}$" },
      "description": "Local only: rule IDs to skip from community base"
    }
  },
  "$defs": {
    "mediaReference": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "tvdbId": { "type": "integer" },
        "imdbId": { "type": "string", "pattern": "^tt\\d+$" },
        "tmdbId": { "type": "integer" },
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["show", "movie"],
          "default": "show"
        }
      }
    },
    "rule": {
      "type": "object",
      "required": ["id", "strategy"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,}$",
          "description": "Unique identifier for override targeting"
        },
        "priority": { "type": "integer", "default": 0 },
        "filters": { "$ref": "#/$defs/filterGroup" },
        "strategy": { "$ref": "#/$defs/matchingStrategy" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "seasonRegex": { "type": "string" },
        "episodeRegex": { "type": "string" },
        "captureGroup": { "type": "integer", "minimum": 0 },
        "titleRules": {
          "type": "array",
          "items": { "$ref": "#/$defs/titleRule" }
        }
      }
    },
    "filterNode": {
      "oneOf": [
        { "$ref": "#/$defs/filter" },
        { "$ref": "#/$defs/filterGroup" }
      ]
    },
    "filter": {
      "type": "object",
      "required": ["field", "op", "value"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": { "$ref": "#/$defs/filterOp" },
        "value": { "type": "string" }
      }
    },
    "filterGroup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": { "type": "array", "items": { "$ref": "#/$defs/filterNode" } },
        "any": { "type": "array", "items": { "$ref": "#/$defs/filterNode" } },
        "not": { "type": "array", "items": { "$ref": "#/$defs/filterNode" } }
      }
    },
    "matchingStrategy": {
      "type": "string",
      "enum": [
        "seasonAndEpisodeNumber",
        "itemTitleExact",
        "itemTitleIncludes",
        "itemTitleEqualsAirdate",
        "byAbsoluteEpisodeNumber"
      ]
    },
    "filterOp": {
      "type": "string",
      "enum": [
        "greaterThan",
        "lessThan",
        "eq",
        "contains",
        "notContains",
        "regex"
      ]
    },
    "titleRule": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/titleRuleType" },
        "field": { "type": "string" },
        "pattern": { "type": "string" },
        "captureGroup": { "type": "integer", "minimum": 0 },
        "value": { "type": "string" }
      }
    },
    "titleRuleType": {
      "type": "string",
      "enum": ["regex", "static"]
    }
  }
}
